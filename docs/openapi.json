{
  "components": {
    "schemas": {
      "Credentials": {
        "properties": {
          "email": {
            "format": "email",
            "title": "Email",
            "type": "string"
          },
          "password": {
            "maxLength": 128,
            "minLength": 8,
            "title": "Password",
            "type": "string"
          }
        },
        "required": [
          "email",
          "password"
        ],
        "title": "Credentials",
        "type": "object"
      },
      "HTTPValidationError": {
        "properties": {
          "detail": {
            "items": {
              "$ref": "#/components/schemas/ValidationError"
            },
            "title": "Detail",
            "type": "array"
          }
        },
        "title": "HTTPValidationError",
        "type": "object"
      },
      "LoginRequest": {
        "properties": {
          "email": {
            "format": "email",
            "title": "Email",
            "type": "string"
          },
          "password": {
            "maxLength": 128,
            "minLength": 1,
            "title": "Password",
            "type": "string"
          }
        },
        "required": [
          "email",
          "password"
        ],
        "title": "LoginRequest",
        "type": "object"
      },
      "MarketItem": {
        "properties": {
          "ask": {
            "anyOf": [
              {
                "type": "string"
              },
              {
                "type": "null"
              }
            ],
            "title": "Ask"
          },
          "bid": {
            "anyOf": [
              {
                "type": "string"
              },
              {
                "type": "null"
              }
            ],
            "title": "Bid"
          },
          "received_at": {
            "anyOf": [
              {
                "type": "string"
              },
              {
                "type": "null"
              }
            ],
            "title": "Received At"
          },
          "spread": {
            "anyOf": [
              {
                "type": "string"
              },
              {
                "type": "null"
              }
            ],
            "title": "Spread"
          },
          "symbol": {
            "title": "Symbol",
            "type": "string"
          },
          "tradeable": {
            "title": "Tradeable",
            "type": "boolean"
          }
        },
        "required": [
          "symbol",
          "tradeable"
        ],
        "title": "MarketItem",
        "type": "object"
      },
      "MeOut": {
        "properties": {
          "cash": {
            "title": "Cash",
            "type": "string"
          },
          "email": {
            "title": "Email",
            "type": "string"
          },
          "id": {
            "title": "Id",
            "type": "string"
          }
        },
        "required": [
          "id",
          "email",
          "cash"
        ],
        "title": "MeOut",
        "type": "object"
      },
      "OrderIn": {
        "properties": {
          "expected_price": {
            "anyOf": [
              {
                "pattern": "^\\d{1,20}(\\.\\d{1,18})?$",
                "type": "string"
              },
              {
                "type": "null"
              }
            ],
            "title": "Expected Price"
          },
          "quantity": {
            "pattern": "^\\d{1,20}(\\.\\d{1,18})?$",
            "title": "Quantity",
            "type": "string"
          },
          "side": {
            "enum": [
              "BUY",
              "SELL"
            ],
            "title": "Side",
            "type": "string"
          },
          "symbol": {
            "pattern": "^[A-Z0-9]{2,20}$",
            "title": "Symbol",
            "type": "string"
          }
        },
        "required": [
          "symbol",
          "side",
          "quantity"
        ],
        "title": "OrderIn",
        "type": "object"
      },
      "OrderOut": {
        "properties": {
          "cash_after": {
            "title": "Cash After",
            "type": "string"
          },
          "fee": {
            "title": "Fee",
            "type": "string"
          },
          "fill_price": {
            "title": "Fill Price",
            "type": "string"
          },
          "order_id": {
            "title": "Order Id",
            "type": "string"
          },
          "quantity": {
            "title": "Quantity",
            "type": "string"
          },
          "quote": {
            "$ref": "#/components/schemas/QuoteOut"
          },
          "side": {
            "title": "Side",
            "type": "string"
          },
          "symbol": {
            "title": "Symbol",
            "type": "string"
          },
          "trade_id": {
            "title": "Trade Id",
            "type": "string"
          }
        },
        "required": [
          "order_id",
          "trade_id",
          "symbol",
          "side",
          "fill_price",
          "quantity",
          "fee",
          "cash_after",
          "quote"
        ],
        "title": "OrderOut",
        "type": "object"
      },
      "PortfolioOut": {
        "properties": {
          "cash": {
            "title": "Cash",
            "type": "string"
          },
          "equity": {
            "title": "Equity",
            "type": "string"
          },
          "positions": {
            "items": {
              "$ref": "#/components/schemas/PositionOut"
