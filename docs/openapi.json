          },
          "unrealized_pnl": {
            "title": "Unrealized Pnl",
            "type": "string"
          },
          "valued_at": {
            "title": "Valued At",
            "type": "string"
          }
        },
        "required": [
          "cash",
          "equity",
          "realized_pnl",
          "unrealized_pnl",
          "valued_at",
          "positions"
