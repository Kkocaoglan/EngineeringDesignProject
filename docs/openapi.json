          },
          "market_value": {
            "title": "Market Value",
            "type": "string"
          },
          "quantity": {
            "title": "Quantity",
            "type": "string"
          },
          "symbol": {
            "title": "Symbol",
            "type": "string"
          },
          "unrealized_pnl": {
            "title": "Unrealized Pnl",
            "type": "string"
          }
        },
        "required": [
          "symbol",
          "quantity",
          "avg_cost",
          "market_value",
          "unrealized_pnl"
        ],
        "title": "PositionOut",
        "type": "object"
      },
      "QuoteOut": {
        "properties": {
          "ask": {
            "title": "Ask",
            "type": "string"
          },
          "bid": {
            "title": "Bid",
            "type": "string"
          },
          "received_at": {
            "title": "Received At",
            "type": "string"
          }
        },
        "required": [
          "bid",
          "ask",
          "received_at"
        ],
        "title": "QuoteOut",
        "type": "object"
      },
      "TradeOut": {
        "properties": {
          "ask": {
            "title": "Ask",
            "type": "string"
          },
          "bid": {
            "title": "Bid",
            "type": "string"
          },
          "created_at": {
            "title": "Created At",
            "type": "string"
          },
          "fee": {
            "title": "Fee",
            "type": "string"
          },
          "id": {
            "title": "Id",
            "type": "string"
          },
          "notional": {
            "title": "Notional",
            "type": "string"
          },
          "order_id": {
            "title": "Order Id",
            "type": "string"
          },
          "price": {
            "title": "Price",
            "type": "string"
          },
          "quantity": {
            "title": "Quantity",
            "type": "string"
          },
          "quote_received_at": {
            "title": "Quote Received At",
            "type": "string"
          },
          "realized_pnl": {
            "title": "Realized Pnl",
            "type": "string"
          },
          "side": {
            "title": "Side",
            "type": "string"
          },
          "symbol": {
            "title": "Symbol",
            "type": "string"
          }
        },
        "required": [
          "id",
          "order_id",
          "symbol",
          "side",
          "quantity",
          "price",
          "notional",
          "fee",
          "realized_pnl",
          "bid",
          "ask",
          "quote_received_at",
          "created_at"
        ],
        "title": "TradeOut",
        "type": "object"
      },
      "TradePage": {
        "properties": {
          "items": {
            "items": {
              "$ref": "#/components/schemas/TradeOut"
            },
            "title": "Items",
            "type": "array"
          },
          "next_cursor": {
            "anyOf": [
              {
                "type": "string"
              },
              {
                "type": "null"
              }
            ],
            "title": "Next Cursor"
          }
        },
        "required": [
          "items",
          "next_cursor"
        ],
        "title": "TradePage",
        "type": "object"
      },
      "UserOut": {
        "properties": {
          "email": {
            "title": "Email",
            "type": "string"
          },
          "id": {
            "title": "Id",
            "type": "string"
          }
        },
        "required": [
